<?xml version="1.0" encoding="utf-8"?>
<!--
    Health data and the auth key never go to a cloud backup (Google, Xiaomi …). Only a direct transfer
    from phone to phone (cable or nearby) may take them along. HelioLink's own backups are separate.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
